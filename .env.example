# Copy this file to .env and fill in values from https://q.qq.com

QQ_BOT_APP_ID=your-app-id
QQ_BOT_APP_SECRET=your-app-secret

# Callback path configured in QQ Open Platform
QQ_BOT_WEBHOOK_PATH=/webhook

# Official API host
QQ_BOT_API_BASE=https://api.bot.qq.com

HOST=127.0.0.1
PORT=8080
PROXY_HOST=0.0.0.0
PROXY_PORT=10002
LOG_LEVEL=INFO
